# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://pos:pos@localhost:5433/pos
API_PORT=3000
BACKOFFICE_URL=http://localhost:5174

# Swish: simulator (default, no money moves), test (Swish's Merchant Swish Simulator) or
# production. test and production need the certificate from Swish Certificate Management and a
# public HTTPS URL that reaches /swish/callback on this API.
SWISH_MODE=simulator
# SWISH_CERT_P12=certs/swish.p12
# SWISH_CERT_PASSPHRASE=
# SWISH_CA=certs/swish-root.pem
# SWISH_CALLBACK_URL=https://api.example.se/swish/callback
